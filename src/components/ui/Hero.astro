---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'
import { profile } from '@/settings'


const { profilePicture } = Astro.props
const { fullName, title, institute, bio } = profile
---
<div class='flex-1'>
  <h1 class='text-4xl font-black mb-4'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    {bio}
  </p>
  <!-- <div class='flex gap-4'>
    <SocialIcons />
  </div> -->
</div>
<div class='size-48 lg:block hidden'>
  <!-- Add your profile image -->
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full rounded-lg size-36'
  />
</div>
