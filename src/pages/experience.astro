---
import Layout from '@/layouts/Layout.astro'
import { getEntry, render } from 'astro:content'

const experience = await getEntry('blog', 'professional-experience')
if (!experience) {
	throw new Error('Missing Professional Experience content')
}

const { Content } = await render(experience)
---

<Layout title='Professional Experience' description={experience.data.excerpt}>
	<section class='legacy-page'>
		<article class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80'>
			<Content />
		</article>
	</section>
</Layout>

<style>
	.legacy-page :global(.experience-list) {
		display: grid;
		gap: 1.25rem;
	}

	.legacy-page :global(.exp-item) {
		align-items: flex-start;
		border: 1px solid hsl(var(--bc) / 0.12);
		border-radius: 0.5rem;
		display: grid;
		gap: 1rem;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		padding: 1rem;
	}

	.legacy-page :global(.exp-logo) {
		border-radius: 0.375rem;
		height: 4rem;
		margin: 0;
		object-fit: contain;
		width: 4rem;
	}

	.legacy-page :global(.exp-header) {
		align-items: baseline;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		justify-content: space-between;
	}

	.legacy-page :global(.exp-title) {
		color: hsl(var(--a));
		font-weight: 700;
		margin-top: 0.35rem;
	}

	@media (max-width: 640px) {
		.legacy-page :global(.exp-item) {
			grid-template-columns: 1fr;
		}
	}
</style>
