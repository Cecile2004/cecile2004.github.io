---
import Layout from '@/layouts/Layout.astro'
---

<Layout title='Moments' description='A personal gallery of travel and life moments from Hong Kong, Shanghai, Ulanqab, Harbin, Changbai Mountains, Dalian, Wudalianchi, Qingdao, and Weihan.'>
	<section class='legacy-page'>
		<article class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80'>
			<h1>Moments</h1>
			<div class='gallery-masonry'>
				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161659828.jpg-slim' alt='May 2025 - Hong Kong' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161657519.jpg-slim' alt='Dec 2024 - Shanghai' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161700813.jpg-slim' alt='Oct 2024 - Ulanqab' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161701157.jpg-slim' alt='Sep 2024 - Harbin' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161658588.jpg-slim' alt='Jul 2024 - Changbai Mountains' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161659134.jpg-slim' alt='May 2024 - Dalian' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161657681.jpg-slim' alt='Apr 2024 - Wudalianchi' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161659441.jpg-slim' alt='Oct 2023 - Qingdao' />
				</div>

				<div class='gallery-item'>
					<img src='https://image.marshuni.fun/liangxinyuan/202509161700018.jpg-slim' alt='Oct 2023 - Weihan' />
				</div>
			</div>
		</article>
	</section>
</Layout>

<style>
	.legacy-page :global(.gallery-masonry) {
		column-count: 3;
		column-gap: 1rem;
		margin-top: 1.5rem;
	}

	.legacy-page :global(.gallery-item) {
		break-inside: avoid;
		margin-bottom: 1rem;
		text-align: center;
	}

	.legacy-page :global(.gallery-item img) {
		border-radius: 0.5rem;
		box-shadow: 0 2px 6px rgb(0 0 0 / 15%);
		height: auto;
		margin: 0;
		transition: transform 0.2s;
		width: 100%;
	}

	.legacy-page :global(.gallery-item img:hover) {
		transform: scale(1.02);
	}

	.legacy-page :global(.gallery-caption) {
		color: hsl(var(--bc) / 0.72);
		font-size: 1rem;
		margin-top: 0.3rem;
	}

	@media (max-width: 900px) {
		.legacy-page :global(.gallery-masonry) {
			column-count: 2;
		}
	}

	@media (max-width: 560px) {
		.legacy-page :global(.gallery-masonry) {
			column-count: 1;
		}
	}
</style>
