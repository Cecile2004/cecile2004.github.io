---
import Layout from '@/layouts/Layout.astro'
import { getEntry, render } from 'astro:content'

const moments = await getEntry('blog', 'moments')
if (!moments) {
	throw new Error('Missing Moments content')
}

const { Content } = await render(moments)
---

<Layout title='Moments' description={moments.data.excerpt}>
	<section class='legacy-page'>
		<article class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80'>
			<Content />
		</article>
	</section>
</Layout>

<style>
	.legacy-page :global(.gallery-masonry) {
		column-count: 3;
		column-gap: 1rem;
		margin-top: 1.5rem;
	}

	.legacy-page :global(.gallery-item) {
		break-inside: avoid;
		margin-bottom: 1rem;
		text-align: center;
	}

	.legacy-page :global(.gallery-item img) {
		border-radius: 0.5rem;
		box-shadow: 0 2px 6px rgb(0 0 0 / 15%);
		height: auto;
		margin: 0;
		transition: transform 0.2s;
		width: 100%;
	}

	.legacy-page :global(.gallery-item img:hover) {
		transform: scale(1.02);
	}

	.legacy-page :global(.gallery-caption) {
		color: hsl(var(--bc) / 0.72);
		font-size: 1rem;
		margin-top: 0.3rem;
	}

	@media (max-width: 900px) {
		.legacy-page :global(.gallery-masonry) {
			column-count: 2;
		}
	}

	@media (max-width: 560px) {
		.legacy-page :global(.gallery-masonry) {
			column-count: 1;
		}
	}
</style>
